# FONT
font-family = Roboto Mono Nerd Font
font-style = medium
# font-style = bold
font-size = 11.5
font-feature = -calt
font-feature = -liga
font-feature = -dlig
# adjust-cell-height = 2
# adjust-cell-width = -1

# WINDOW CONFIGURATION
window-padding-x = 8
window-padding-y = 8
# background-opacity = 1.0
gtk-titlebar-hide-when-maximized = true

# CURSOR CONFIGURATION
cursor-style = block
cursor-style-blink = true

# SCROLLBACK
scrollback-limit = 10000

# TERMINAL FEATURES
copy-on-select = true

# DISABLE ANNOYING COPIED TO CLIPBOARD
app-notifications = no-clipboard-copy

# SHELL INTEGRATION
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# RANDO STUFF
gtk-single-instance = false
quit-after-last-window-closed = false


# # GRUVBOX DARK HARD
background = #17191a
foreground = #ebdbb2
selection-background = #665c54
selection-foreground = #ebdbb2
cursor-color = #ebdbb2
cursor-text = #1d2021
cursor-invert-fg-bg = true
palette = 0=#1d2021
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2
